# Local development uses SQLite and the local uploads/ folder by default.
# For hosted setup, supply a PostgreSQL URL and a private Supabase Storage bucket.
SECRET_KEY=
DATABASE_URL=
DIRECT_URL=
AUTO_INIT_DB=0
STORAGE_BACKEND=local

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=controlcred-private

# Required only when bootstrapping a new hosted database.
INITIAL_ADMIN_PASSWORD=
INITIAL_TENANT_ADMIN_PASSWORD=
